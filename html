<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Kalkulator spalania pojazdu</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #111827, #1f2937);
            color: white;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 850px;
            background: #ffffff;
            color: #111827;

            border-radius: 20px;
            padding: 35px;

            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
        }

        h1 {
            text-align: center;
            font-size: 34px;
            margin-bottom: 10px;
        }

        .opis {
            text-align: center;
            color: #6b7280;
            margin-bottom: 30px;
        }

        /* WYBÓR PALIWA */

        .paliwa {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .paliwo {
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
            background: #f9fafb;
        }

        .paliwo:hover {
            transform: translateY(-3px);
            border-color: #2563eb;
        }

        .paliwo.aktywne {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }

        .paliwo .ikona {
            font-size: 35px;
            margin-bottom: 8px;
        }

        .paliwo h3 {
            margin-bottom: 5px;
        }

        .paliwo p {
            font-size: 13px;
            opacity: 0.8;
        }

        /* FORMULARZ */

        .formularz {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .pole {
            display: flex;
            flex-direction: column;
        }

        .pole label {
            font-weight: bold;
            margin-bottom: 8px;
        }

        .pole input {
            padding: 14px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            font-size: 16px;
            outline: none;
            transition: 0.2s;
        }

        .pole input:focus {
            border-color: #2563eb;
        }

        .pelna-szerokosc {
            grid-column: 1 / -1;
        }

        /* WYNIKI */

        .wyniki {
            margin-top: 30px;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .wynik {
            background: #f3f4f6;
            border-radius: 15px;
            padding: 25px;
            text-align: center;
        }

        .wynik .ikona {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .wynik .tytul {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .wynik .wartosc {
            font-size: 28px;
            font-weight: bold;
            color: #2563eb;
        }

        /* INFORMACJA */

        .info {
            margin-top: 25px;
            background: #eff6ff;
            border-left: 5px solid #2563eb;
            padding: 15px;
            border-radius: 8px;
            color: #1e3a8a;
        }

        /* STOPKA */

        footer {
            text-align: center;
            color: #9ca3af;
            margin-top: 25px;
            font-size: 13px;
        }

        /* TELEFON */

        @media (max-width: 700px) {

            .container {
                padding: 25px 20px;
            }

            h1 {
                font-size: 27px;
            }

            .paliwa {
                grid-template-columns: 1fr;
            }

            .formularz {
                grid-template-columns: 1fr;
            }

            .pelna-szerokosc {
                grid-column: auto;
            }

            .wyniki {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>🚗 Kalkulator spalania</h1>

    <p class="opis">
        Sprawdź spalanie i koszt przejazdu swojego pojazdu
    </p>


    <!-- WYBÓR PALIWA -->

    <div class="paliwa">

        <div class="paliwo aktywne" onclick="wybierzPaliwo('Benzyna', this)">
            <div class="ikona">⛽</div>
            <h3>Benzyna</h3>
            <p>PB95 / PB98</p>
        </div>

        <div class="paliwo" onclick="wybierzPaliwo('Diesel', this)">
            <div class="ikona">🛢️</div>
            <h3>Diesel</h3>
            <p>Olej napędowy</p>
        </div>

        <div class="paliwo" onclick="wybierzPaliwo('LPG', this)">
            <div class="ikona">🔥</div>
            <h3>LPG</h3>
            <p>Gaz</p>
        </div>

    </div>


    <!-- FORMULARZ -->

    <div class="formularz">

        <div class="pole">
            <label for="spalanie">
                Spalanie (l/100 km)
            </label>

            <input
                type="number"
                id="spalanie"
                value="7"
                min="0"
                step="0.1"
                oninput="oblicz()"
            >
        </div>


        <div class="pole">
            <label for="cena">
                Cena paliwa (zł/l)
            </label>

            <input
                type="number"
                id="cena"
                value="6.50"
                min="0"
                step="0.01"
                oninput="oblicz()"
            >
        </div>


        <div class="pole pelna-szerokosc">
            <label for="kilometry">
                Dystans (km)
            </label>

            <input
                type="number"
                id="kilometry"
                value="100"
                min="0"
                step="1"
                oninput="oblicz()"
            >
        </div>

    </div>


    <!-- WYNIKI -->

    <div class="wyniki">

        <div class="wynik">
            <div class="ikona">📊</div>

            <div class="tytul">
                Spalanie
            </div>

            <div class="wartosc">
                <span id="wynikSpalanie">7.00</span>
                l/100 km
            </div>
        </div>


        <div class="wynik">
            <div class="ikona">💰</div>

            <div class="tytul">
                Koszt 100 km
            </div>

            <div class="wartosc">
                <span id="koszt100">45.50</span>
                zł
            </div>
        </div>


        <div class="wynik">
            <div class="ikona">🛣️</div>

            <div class="tytul">
                Koszt trasy
            </div>

            <div class="wartosc">
                <span id="kosztTrasy">45.50</span>
                zł
            </div>
        </div>

    </div>


    <!-- INFORMACJA -->

    <div class="info">
        Wybrane paliwo:
        <strong id="wybranePaliwo">Benzyna</strong>
    </div>


    <footer>
        Kalkulator spalania pojazdu © 2026
    </footer>

</div>


<script>

    let aktualnePaliwo = "Benzyna";


    // WYBÓR PALIWA

    function wybierzPaliwo(paliwo, element) {

        aktualnePaliwo = paliwo;

        document
            .querySelectorAll(".paliwo")
            .forEach(function(el) {
                el.classList.remove("aktywne");
            });

        element.classList.add("aktywne");

        document.getElementById("wybranePaliwo").textContent = paliwo;

        oblicz();
    }


    // OBLICZANIE

    function oblicz() {

        let spalanie =
            parseFloat(
                document.getElementById("spalanie").value
            );

        let cena =
            parseFloat(
                document.getElementById("cena").value
            );

        let kilometry =
            parseFloat(
                document.getElementById("kilometry").value
            );


        // Jeżeli użytkownik nic nie wpisał

        if (isNaN(spalanie)) {
            spalanie = 0;
        }

        if (isNaN(cena)) {
            cena = 0;
        }

        if (isNaN(kilometry)) {
            kilometry = 0;
        }


        // Koszt przejechania 100 km

        let koszt100 =
            spalanie * cena;


        // Koszt całej trasy

        let kosztTrasy =
            (spalanie / 100) *
            kilometry *
            cena;


        // Wyświetlanie wyników

        document.getElementById("wynikSpalanie")
            .textContent = spalanie.toFixed(2);

        document.getElementById("koszt100")
            .textContent = koszt100.toFixed(2);

        document.getElementById("kosztTrasy")
            .textContent = kosztTrasy.toFixed(2);
    }


    // Uruchomienie kalkulatora po otwarciu strony

    oblicz();

</script>

</body>
</html>
